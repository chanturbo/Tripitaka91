# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store

# Bulk log_edit review output (regenerable from tools/log_edit_bulk_review)
tools/log_edit_bulk_review/output/

# public_site/: only the website's own code/small assets are tracked here.
# Large static content (served PDFs, the old Flutter-web build output) stays
# out of git — see public_site/README.md.
public_site/pdf/
public_site/assets/

# tri91_legacy/ is still load-bearing (included by tripitaka91.php /
# tripitaka91_1.php for webconfig.php and vendored CSS/JS) so it's kept on
# disk in full, but only include_file/ (actual PHP code) is tracked — the
# rest is vendored third-party libraries (Bootstrap, jQuery, DataTables,
# jBox, Font Awesome) that don't need git history.
public_site/tri91_legacy/*
!public_site/tri91_legacy/include_file

# Secret-bearing PHP config (DB password, API keys, shared app token) —
# the project's own established convention is to keep these OUT of git
# entirely (workspace/db_connect.php etc. were never committed before this
# move either). Safety net so a future `git add -A` can't sweep them in.
public_site/workspace/db_connect.php
public_site/workspace/db_correction.php
public_site/workspace/websiteconfig.php
public_site/tri91_legacy/include_file/dbconnect.php
public_site/tri91_legacy/include_file/dbconnect1.php
public_site/tri91_legacy/include_file/dbconnect_odbc.php

# Runtime-generated TTS audio cache, not source.
public_site/workspace/sounds/
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing secrets
key.properties
*.jks
*.keystore

# Generated/cached TTS audio files (not source)
workspace/sounds/

# Backend config files with live secrets (DB password, API keys, auth token) —
# keep these only on disk/on the server, never in the (public) repo
workspace/db_connect.php
workspace/db_correction.php
workspace/websiteconfig.php
